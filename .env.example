# Copiar a .env y ajustar los valores según el entorno local.
# Las variables ya definidas en el entorno tienen prioridad sobre el .env.

# Conexión a MySQL (valores por defecto)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sport_reserve

# Alternativa: URL completa (tiene prioridad sobre las variables de arriba)
# DB_URL=mysql+pymysql://root@localhost:3306/sport_reserve?charset=utf8mb4
